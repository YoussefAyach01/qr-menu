# Path of the SQLite file (node:sqlite, no server needed). Use a persistent disk in production.
DATABASE_PATH=./data/qr-menu.db

# REQUIRED in production: 32+ random chars used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-change-me-dev-only

# Public site URL, used to build the QR code link (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3110

# Optional: enables the "Upgrade" button. Leave empty and the app shows "payments not configured".
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
